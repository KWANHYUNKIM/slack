# docker-compose.yml 용 환경 변수. 복사해서 .env 로 만들고 값을 채운다 (.env 는 커밋하지 않는다).
# 키 이름만 적었다. 비밀 값은 직접 생성한다.

# 필수: openssl rand -hex 32 로 생성
JWT_SECRET=
# 필수: DB 비밀번호 (compose가 DATABASE_URL을 조립한다)
POSTGRES_PASSWORD=

# 호스트에 공개할 포트 (기본 8080)
# APP_PORT=8080
# 운영에서 CORS 허용 출처 (예: https://chat.example.com)
# CORS_ORIGIN=
# 웹 푸시 VAPID 키 (선택)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# 파일 업로드 최대 크기(MB)
# MAX_FILE_SIZE_MB=
# 허들 STUN/TURN (선택)
# STUN_ENABLED=
# STUN_PUBLIC_HOST=
# TURN_URLS=
# TURN_USERNAME=
# TURN_CREDENTIAL=
