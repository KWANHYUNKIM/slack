# docker-compose.yml 용 환경 변수. 복사해서 .env 로 만들고 값을 채운다 (.env 는 커밋하지 않는다).
# 키 이름만 적었다. 비밀 값은 직접 생성한다.

# 필수: openssl rand -hex 32 로 생성 (운영에서는 32자 이상)
JWT_SECRET=
# 필수: DB 비밀번호. 특수문자가 있어도 entrypoint가 인코딩해서 연결한다.
# 단, compose가 .env 값을 보간하므로 $ 는 $$ 로 쓴다(한 개만 쓰면 뒤 문자가 변수 이름으로 해석된다).
POSTGRES_PASSWORD=

# 첫 OWNER 생성 CLI(`node dist/scripts/create-owner.js`)용. 가능하면 비워 두고 대화형 입력을 쓴다.
# 이메일·이름은 비워 두면 --email, --name 옵션으로 넘긴다. 비밀번호는 비워 두고 숨김 프롬프트로 입력한다.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_PASSWORD=

# 호스트에 공개할 포트 (기본 8080)
# APP_PORT=8080
# 서비스 공개 주소. 운영은 TLS 리버스 프록시 뒤에서 https:// 를 권장한다.
# http:// 로 두면 HSTS와 upgrade-insecure-requests, secure 쿠키를 끈다(LAN 시험용).
# PUBLIC_URL=https://chat.example.com
# 앞단 프록시 홉 수 (기본 0 = 신뢰 안 함). 리버스 프록시 뒤에서는 1.
# TRUST_PROXY=0
# 운영에서 CORS 허용 출처 (예: https://chat.example.com)
# CORS_ORIGIN=
# 웹 푸시 VAPID 키 (선택)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# 파일 업로드 최대 크기(MB)
# MAX_FILE_SIZE_MB=
# 허들 STUN/TURN. 내장 STUN은 기본 켜짐이고 3478/udp 를 공개한다. 끄려면 STUN_ENABLED=false.
# STUN_ENABLED=true
# STUN_PORT=3478
# STUN_PUBLIC_HOST=
# TURN_URLS=
# TURN_USERNAME=
# TURN_CREDENTIAL=
