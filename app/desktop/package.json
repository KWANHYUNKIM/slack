{
  "name": "slackclone-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop shell that opens a self-hosted workspace server",
  "license": "MIT",
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\" && node scripts/check-builder-config.mjs",
    "check:builder": "node scripts/check-builder-config.mjs",
    "icon": "node scripts/make-icon.mjs",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
