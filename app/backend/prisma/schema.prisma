generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum ChannelRole {
  OWNER
  MODERATOR
  MEMBER
}

// 조직 역할(E1). 워크스페이스 역할(WorkspaceMember.role)과 별개 축이다.
enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceDiscoverability {
  OPEN // 조직 멤버 누구나 목록에서 보고 참여
  INVITE_ONLY // 목록에는 보이지만 초대·관리자 배정으로만
  HIDDEN // 목록에 안 보임, 초대·배정으로만
}

// 조직(E1). 서버당 하나(D1)이고 id=1 행은 마이그레이션이 만든다. 조직 생성 API는 없다.
model Organization {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  primaryOwnerId Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  primaryOwner User?       @relation("OrganizationPrimaryOwner", fields: [primaryOwnerId], references: [id], onDelete: SetNull)
  workspaces   Workspace[]
  users        User[]      @relation("OrganizationUsers")
}

// 워크스페이스(E1). 기본 워크스페이스 id=1은 마이그레이션이 만든다. 하드 삭제 없이 archivedAt으로 보관한다(D6).
model Workspace {
  id              Int                      @id @default(autoincrement())
  organizationId  Int
  slug            String                   @db.VarChar(21) // 소문자·숫자·하이픈. 조직 안에서 유일
  name            String                   @db.VarChar(100)
  description     String?                  @db.VarChar(500)
  discoverability WorkspaceDiscoverability @default(INVITE_ONLY)
  icon            String?                  @db.VarChar(500) // 업로드 파일 경로(외부 URL 금지)
  createdBy       Int?
  archivedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @default(now()) @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members         WorkspaceMember[]
  channels        ChannelWorkspace[]
  hostedChannels  Channel[]          @relation("ChannelHost")
  inviteLinks     InviteLink[]
  defaultForUsers User[]             @relation("UserDefaultWorkspace")

  @@unique([organizationId, slug])
  @@unique([organizationId, name])
  @@index([organizationId, archivedAt])
  // 마이그레이션에만 있는 함수 유니크 인덱스 "Workspace_organizationId_lower_name_key"(organizationId, lower(name))가
  // 이름을 대소문자 무시로 유일하게 한다(20261102015000). Prisma로 표현할 수 없으니 migrate dev가 지우는 diff를 만들면 그 줄을 빼야 한다.
}

// 사용자의 워크스페이스 참여. 나가거나 제거되면 행을 지우지 않고 leftAt을 채운다(재참여 시 갱신, 감사·eDiscovery용).
model WorkspaceMember {
  workspaceId Int
  userId      Int
  role        Role      @default(MEMBER)
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  invitedBy   Int?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId, leftAt])
  @@index([workspaceId, leftAt, role])
}

// 채널이 보이는 워크스페이스. 공유하면 행이 늘어난다. 호스트 여부는 따로 두지 않고 Channel.workspaceId와 같은
// 워크스페이스의 행인지로 판단한다(workspaceService.isHostRow). 모든 채널은 호스트 워크스페이스의 행을 정확히 하나 가진다.
// nameKey는 Channel.name의 소문자형이고 이름 유일성을 워크스페이스 단위로 강제한다.
model ChannelWorkspace {
  channelId   Int
  workspaceId Int
  isDefault   Boolean  @default(false) // 기본 채널로 지정됨. 자동 가입은 이 중 공개·미보관 채널만(defaultChannelService)
  defaultSlot String?  @db.VarChar(20) // 이 행이 채우는 기본 채널 자리(general·random). 이름을 바꿔도 자리는 유지된다
  nameKey     String   @db.VarChar(80)
  sharedBy    Int?
  sharedAt    DateTime @default(now())

  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([channelId, workspaceId])
  @@unique([workspaceId, nameKey])
  @@unique([workspaceId, defaultSlot])
  @@index([workspaceId, isDefault])
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  password      String    @db.VarChar(255)
  name          String    @db.VarChar(100)
  avatar        String?   @db.VarChar(500)
  status        String?   @default("online") @db.VarChar(20)
  bio           String?   @db.VarChar(500)
  role          Role      @default(MEMBER)
  deactivatedAt DateTime?
  tokenVersion  Int       @default(0)
  lastSeen      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  // 커스텀 상태와 방해금지(05). status(프레즌스)와 별개 축이다.
  customStatusEmoji     String?   @db.VarChar(50)
  customStatusText      String?   @db.VarChar(100)
  customStatusExpiresAt DateTime?
  dndUntil              DateTime?
  dndWithStatus         Boolean   @default(false)

  // 다국어(i18n-3). locale은 BCP-47, timeZone은 IANA 이름. 비어 있으면 요청/서버 기본값을 쓴다.
  locale   String? @db.VarChar(35)
  timeZone String? @db.VarChar(64)

  // 2단계 인증(E7b). 비밀은 AES-256-GCM으로 암호화한 값만 둔다. mfaEnabledAt이 있으면 켜진 상태다.
  // mfaPendingSecret은 등록 중(코드 확인 전) 비밀, mfaLastUsedStep은 마지막으로 받은 30초 창(같은 코드 재사용 방지).
  mfaSecret        String?   @db.VarChar(255)
  mfaPendingSecret String?   @db.VarChar(255)
  mfaEnabledAt     DateTime?
  mfaLastUsedStep  Int?

  // 조직·워크스페이스(E1a). 서버당 조직이 하나라 organizationId 기본값은 1이다.
  // role은 E1h까지 호환 컬럼으로 남고, 그동안 WorkspaceMember.role(기본 워크스페이스)과 orgRole은
  // services/workspaceService.ts의 setUserRole로만 바뀌고 같은 값을 따라간다.
  organizationId     Int     @default(1)
  orgRole            OrgRole @default(MEMBER)
  defaultWorkspaceId Int?

  organization     Organization      @relation("OrganizationUsers", fields: [organizationId], references: [id], onDelete: Restrict)
  defaultWorkspace Workspace?        @relation("UserDefaultWorkspace", fields: [defaultWorkspaceId], references: [id], onDelete: SetNull)
  ownedOrgs        Organization[]    @relation("OrganizationPrimaryOwner")
  workspaces       WorkspaceMember[]

  messages           Message[]
  channels           ChannelMember[]
  reactions          Reaction[]
  dmReactions        DMReaction[]
  files              File[]
  sentDMs            DirectMessage[] @relation("SentMessages")
  receivedDMs        DirectMessage[] @relation("ReceivedMessages")
  channelReads       ChannelRead[]
  bookmarks          Bookmark[]
  scheduledMessages  ScheduledMessage[]
  inviteLinks        InviteLink[]
  auditLogs          AuditLog[]
  dlpRules           DlpRule[]
  pushSubscriptions  PushSubscription[]
  webhooks           Webhook[]
  activitiesReceived Activity[] @relation("ActivityRecipient")
  activitiesSent     Activity[] @relation("ActivityActor")
  reminders          Reminder[]
  channelStars       ChannelStar[]
  dmStars            DMStar[]      @relation("DMStarOwner")
  dmStarredBy        DMStar[]      @relation("DMStarTarget")
  sidebarPref        SidebarPref?
  dmGroups           DMGroupMember[]
  dmGroupHistory     DMGroupMembership[]
  threadReads        ThreadRead[]
  accessTokens       PersonalAccessToken[]
  sessions           Session[]
  mfaRecoveryCodes   MfaRecoveryCode[]
  mfaChallenges      MfaChallenge[]
  legalHoldsCreated  LegalHold[]          @relation("LegalHoldCreator")
  legalHoldsReleased LegalHold[]          @relation("LegalHoldReleaser")
  legalHoldCustody   LegalHoldCustodian[]
  oauthCodes         OAuthAuthorizationCode[]
  oauthTokens        OAuthToken[]

  // 법적 보존(E6). true면 이 사용자가 쓰거나 받은 메시지는 데이터 보존 정리(E5)에서 제외한다.
  // 원본은 LegalHold·LegalHoldCustodian이다. 활성(releasedAt 없음) 보존 건의 대상이면 true이며 legalHoldService가 동기화한다.
  // 정리 쿼리가 조인 없이 거르도록 남겨 둔 캐시라 직접 바꾸지 않는다.
  legalHold Boolean @default(false)

  @@index([dndUntil])
  @@index([customStatusExpiresAt])
}

model InviteLink {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(64)
  createdBy Int
  role      Role      @default(MEMBER)
  maxUses   Int?
  useCount  Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  creator   User      @relation(fields: [createdBy], references: [id])

  // 초대로 들어갈 워크스페이스(E1a). 지금은 기본 워크스페이스(1)뿐이다.
  workspaceId Int       @default(1)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Channel {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(80) // 유일성은 워크스페이스 단위(ChannelWorkspace.nameKey 유니크, E1c)
  isPrivate  Boolean   @default(false)
  createdBy  Int?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  topic       String?  @db.VarChar(250)
  description String?  @db.VarChar(500)

  // 데이터 보존(E5). null이면 워크스페이스 기본을 따르고, 0이면 이 채널만 무기한, 1 이상이면 N일 뒤 삭제한다.
  retentionDays Int?
  // 법적 보존(E6). true면 이 채널은 보존 정리에서 제외한다.
  legalHold     Boolean @default(false)

  // 호스트 워크스페이스(E1a). 보존 재정의·관리 권한의 기준이고 공유 여부와 무관하게 하나다.
  // 보이는 워크스페이스 목록은 workspaces(ChannelWorkspace)다.
  workspaceId Int                @default(1)
  host        Workspace          @relation("ChannelHost", fields: [workspaceId], references: [id], onDelete: Restrict)
  workspaces  ChannelWorkspace[]

  messages           Message[]
  stars              ChannelStar[]
  members            ChannelMember[]
  reads              ChannelRead[]
  scheduledMessages  ScheduledMessage[]
  webhooks           Webhook[]

  @@index([workspaceId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String   @db.VarChar(100)
  actorId    Int? // 로그인 실패처럼 사용자를 특정할 수 없는 기록은 비운다
  targetType String   @db.VarChar(50)
  targetId   Int?
  targetName String?  @db.VarChar(200)
  details    String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// 법적 보존 건(E6). 해제(releasedAt)해도 행은 지우지 않는다(누가 언제 무엇을 보존했는지가 기록으로 남아야 한다).
model LegalHold {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(1000)
  createdBy   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  releasedAt  DateTime?
  releasedBy  Int?

  creator    User?                @relation("LegalHoldCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  releaser   User?                @relation("LegalHoldReleaser", fields: [releasedBy], references: [id], onDelete: SetNull)
  custodians LegalHoldCustodian[]

  @@index([releasedAt])
}

// 보존 건의 대상 사용자(custodian). 한 사용자가 여러 보존 건에 들 수 있다.
model LegalHoldCustodian {
  holdId  Int
  userId  Int
  addedBy Int?
  addedAt DateTime @default(now())

  hold LegalHold @relation(fields: [holdId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([holdId, userId])
  @@index([userId])
}

// 워크스페이스 설정(E5). 행은 id=1 하나뿐이다(멀티 워크스페이스(E1)에서 workspaceId로 바꾼다).
// messageRetentionDays가 null이면 무기한이다. DM과 그룹 DM은 이 값을 따른다.
// requireMfa(E7b): 모든 사용자 2FA 필수. 보존 정책과 같은 행을 쓰고, 각 서비스는 자기 컬럼만 upsert한다.
model WorkspaceSetting {
  id                   Int      @id @default(1)
  messageRetentionDays Int?
  requireMfa           Boolean  @default(false)
  // OAuth 앱(claude.ai 커넥터 등) 연결 허용(mcp-4). 끄면 새 연결과 토큰 발급·사용이 모두 막힌다.
  allowOAuthApps       Boolean  @default(true)
  updatedAt            DateTime @default(now()) @updatedAt
}

model ChannelMember {
  userId    Int
  channelId Int
  role      ChannelRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  user      User     @relation(fields: [userId], references: [id])
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
}

model Message {
  id        Int       @id @default(autoincrement())
  content   String
  userId    Int
  channelId Int
  threadId  Int?
  alsoSendToChannel Boolean @default(false) // 스레드 답글을 채널 타임라인에도 보여 준다(답글에만 의미 있음)
  isPinned  Boolean   @default(false)
  pinnedBy  Int?
  pinnedAt  DateTime?
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [id])
  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  reactions    Reaction[]
  files        File[]
  parent       Message?      @relation("MessageThread", fields: [threadId], references: [id])
  replies      Message[]     @relation("MessageThread")
  bookmarks    Bookmark[]
  channelReads ChannelRead[] @relation("ChannelReadMessage")
  threadReads  ThreadRead[]  @relation("ThreadReadParent")

  @@index([channelId, createdAt])
  @@index([threadId])
}

// 스레드(부모 메시지)별 읽음 위치. 행이 없으면 다른 사람의 답글이 전부 안 읽음이다.
model ThreadRead {
  id              Int      @id @default(autoincrement())
  userId          Int
  threadId        Int
  lastReadReplyId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Message @relation("ThreadReadParent", fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId, updatedAt])
}

model Reaction {
  id        Int      @id @default(autoincrement())
  emoji     String   @db.VarChar(50)
  userId    Int
  messageId Int
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id])
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, emoji])
  @@index([messageId])
}

model File {
  id           Int      @id @default(autoincrement())
  filename     String   @db.VarChar(255)
  originalName String   @db.VarChar(255)
  mimetype     String   @db.VarChar(127)
  size         Int
  url          String
  gcsPath      String?
  userId       Int
  messageId    Int?
  dmId         Int?
  createdAt    DateTime @default(now())

  // 소프트 삭제로 메시지에서 분리될 때 원래 붙어 있던 메시지 id(E6 eDiscovery가 삭제된 메시지의 첨부를 찾는다).
  // FK 없이 둔다: 메시지가 보존 정리로 하드 삭제돼도 기록으로 남는다.
  detachedFromMessageId Int?
  detachedFromDmId      Int?

  user      User            @relation(fields: [userId], references: [id])
  message   Message?        @relation(fields: [messageId], references: [id], onDelete: SetNull)
  dm        DirectMessage?  @relation(fields: [dmId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([messageId])
  @@index([dmId])
  @@index([detachedFromMessageId])
  @@index([detachedFromDmId])
}

model DirectMessage {
  id         Int       @id @default(autoincrement())
  content    String
  fromUserId Int
  toUserId   Int?      // 그룹 DM 메시지는 null (groupId와 둘 중 하나만 채워진다, DB CHECK 제약)
  groupId    Int?
  threadId   Int?
  isPinned   Boolean   @default(false)
  pinnedBy   Int?
  pinnedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  editedAt   DateTime?
  deletedAt  DateTime?
  readAt     DateTime?

  fromUser   User             @relation("SentMessages", fields: [fromUserId], references: [id])
  toUser     User?            @relation("ReceivedMessages", fields: [toUserId], references: [id], onDelete: Restrict)
  group      DMGroup?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parent     DirectMessage?   @relation("DMThread", fields: [threadId], references: [id])
  replies    DirectMessage[]  @relation("DMThread")
  reactions  DMReaction[]
  files      File[]

  @@index([fromUserId, toUserId])
  @@index([toUserId, fromUserId])
  @@index([groupId, createdAt])
  @@index([threadId])
  @@index([createdAt, id]) // 데이터 보존 정리(E5)가 오래된 DM을 id 순서로 찾는다
}

// 그룹 DM(본인 포함 3~9명). memberKey는 현재 멤버 id를 정렬해 '-'로 이은 값으로, 같은 멤버 집합의 중복 생성을 막는다.
// 나가기·추가로 다른 그룹과 키가 겹치면 '#<id>'를 붙여 떼어 둔다(재사용 대상에서 빠진다).
model DMGroup {
  id        Int      @id @default(autoincrement())
  name      String?  @db.VarChar(100)
  memberKey String   @unique @db.VarChar(255)
  createdBy Int
  createdAt DateTime @default(now())

  members     DMGroupMember[]
  memberships DMGroupMembership[]
  messages    DirectMessage[]
}

model DMGroupMember {
  groupId      Int
  userId       Int
  lastReadDmId Int?      // 읽음 커서: 이 id까지 읽었다
  starredAt    DateTime? // 사이드바 별표(사용자별)
  joinedAt     DateTime  @default(now())

  group DMGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

// 그룹 DM 구성원 이력. 들어온 때마다 한 행(재가입하면 행이 하나 더 생긴다), 나가면 leftAt을 채운다(앱 시각, DirectMessage.createdAt과 같은 시계).
// DMGroupMember는 지금 구성원만 담으므로, "그 사람이 볼 수 있었던 메시지"(eDiscovery, 보존 정리의 법적 보존 제외)는 이 표의 leftAt으로 판단한다
// (dmGroupService.groupDmVisibleSql). joinedAt은 감사·조사용 기록이며 범위 판단에는 쓰지 않는다. dmGroupService만 쓴다.
// 마이그레이션에만 있는 부분 유니크 인덱스 "DMGroupMembership_open_key"(groupId, userId WHERE leftAt IS NULL)가 열린 구간을 하나로 묶는다.
model DMGroupMembership {
  id       Int       @id @default(autoincrement())
  groupId  Int
  userId   Int
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  group DMGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, userId])
  @@index([userId])
}

model DMReaction {
  id        Int      @id @default(autoincrement())
  emoji     String   @db.VarChar(50)
  userId    Int
  dmId      Int
  createdAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id])
  dm   DirectMessage   @relation(fields: [dmId], references: [id], onDelete: Cascade)

  @@unique([userId, dmId, emoji])
  @@index([dmId])
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    Int
  messageId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId])
}

model ChannelRead {
  id                Int      @id @default(autoincrement())
  userId            Int
  channelId         Int
  lastReadMessageId Int?
  updatedAt         DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
  channel         Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadMessage Message? @relation("ChannelReadMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([userId, channelId])
}

model ScheduledMessage {
  id          Int      @id @default(autoincrement())
  content     String
  channelId   Int
  userId      Int
  scheduledAt DateTime
  createdAt   DateTime @default(now())
  sent        Boolean  @default(false)
  // 발송 시점에 막혀 보내지 못했을 때(예: DLP). sent는 true로 두어 다시 시도하지 않고, 목록에는 실패로 보인다.
  failedAt    DateTime?
  failReason  String?  @db.VarChar(200)

  user    User    @relation(fields: [userId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([scheduledAt, sent])
  @@index([userId])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

model Webhook {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  channelId   Int
  token       String    @unique @db.VarChar(64)
  createdBy   Int
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  lastUsedAt  DateTime?

  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  creator     User      @relation(fields: [createdBy], references: [id])

  @@index([channelId])
  @@index([token])
}

enum ActivityType {
  MENTION
  CHANNEL_MENTION
  HERE_MENTION
  THREAD_REPLY
  REACTION
  REMINDER
}

// 내 활동 탭의 항목. messageId/dmId는 FK 없이 두고(채널 메시지와 DM 둘 다 가리킴) 삭제는 서비스에서 정리한다.
model Activity {
  id        Int          @id @default(autoincrement())
  userId    Int
  actorId   Int
  type      ActivityType
  messageId Int?
  dmId      Int?
  channelId Int?
  reminderId Int?        // REMINDER 활동이면 리마인더 id(같은 메시지에 여러 리마인더가 있어도 활동을 따로 둔다)
  reminderSeq Int?       // 몇 번째 발송인지(스누즈 후 다시 울릴 때 새 활동이 생기게 unique에 포함)
  dmGroupId Int?         // 그룹 DM 활동이면 그룹 id(나간 그룹의 활동을 가리고, 그룹별 멘션 수를 센다)
  emoji     String?      @db.VarChar(50)
  readAt    DateTime?
  createdAt DateTime     @default(now())

  user  User @relation("ActivityRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  // NULL 컬럼이 들어가면 Postgres는 NULL끼리 다르다고 보므로 이 unique는 중복을 못 막는다.
  // 그래서 mentionService가 생성 전에 기존 행을 먼저 조회해 중복을 거른다.
  @@unique([userId, type, messageId, dmId, actorId, emoji, reminderId, reminderSeq])
  @@index([userId, readAt, createdAt])
  @@index([messageId])
  @@index([dmId])
  @@index([userId, channelId, readAt])
  @@index([userId, dmGroupId, readAt])
}

// 즐겨찾기(채널)
model ChannelStar {
  userId    Int
  channelId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@index([channelId])
}

// 즐겨찾기(1:1 DM 상대)
model DMStar {
  userId      Int
  otherUserId Int
  createdAt   DateTime @default(now())

  user      User @relation("DMStarOwner", fields: [userId], references: [id], onDelete: Cascade)
  otherUser User @relation("DMStarTarget", fields: [otherUserId], references: [id], onDelete: Cascade)

  @@id([userId, otherUserId])
  @@index([otherUserId])
}

// 사이드바 섹션 접기 상태. 예: {"starred":false,"channels":true,"dms":false}
model SidebarPref {
  userId    Int      @id
  collapsed Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 리마인더. messageId/dmId는 FK 없이 둔다(대상 메시지가 지워져도 리마인더는 남고 화면에서 "삭제된 메시지"로 보인다).
model Reminder {
  id          Int       @id @default(autoincrement())
  userId      Int
  messageId   Int?      // 채널 메시지
  dmId        Int?      // 1:1 또는 그룹 DM 메시지
  channelId   Int?
  text        String?   @db.VarChar(500) // /remind 로 만든 경우의 본문
  remindAt    DateTime
  firedAt     DateTime?
  completedAt DateTime?
  fireSeq     Int       @default(0) // 선점(발송)할 때마다 +1. 활동의 reminderSeq와 짝
  failCount   Int       @default(0) // 발송 실패 횟수. 한도에 닿으면 failedAt을 찍고 더 시도하지 않는다
  failedAt    DateTime?
  locale      String?   @db.VarChar(8) // 만든 때의 언어(푸시 문구용)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt, remindAt])
  @@index([remindAt, firedAt])
}

// MCP용 개인 액세스 토큰(mcp-1). 원문은 발급 응답에서 한 번만 보여 주고 DB에는 sha256 해시만 둔다.
// publicId는 토큰 안에 들어 있는 조회 키다. 비밀 부분은 해시를 상수 시간으로 비교한다.
model PersonalAccessToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  name       String    @db.VarChar(100)
  publicId   String    @unique @db.VarChar(16)
  tokenHash  String    @db.Char(64)
  scopes     String[]
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// 로그인 세션(E7). 로그인마다 한 행을 만들고 JWT의 sid가 가리킨다. 폐기(revokedAt)하면 그 토큰만 무효가 된다.
// 전체 무효화(tokenVersion)와 별개 축이다. id는 추측할 수 없는 랜덤 hex라 목록 API에서 그대로 보여 줘도 된다.
// ip는 앞부분만 남긴 마스킹 값이고 원문 IP는 저장하지 않는다.
model Session {
  id         String    @id @db.VarChar(32)
  userId     Int
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?   @db.VarChar(120)
  ip         String?   @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([lastSeenAt])
  @@index([revokedAt])
}

// 2FA 복구 코드(E7b). 원문은 등록할 때 한 번만 보여 주고 SHA-256 해시만 둔다. 쓰면 usedAt이 채워져 다시 못 쓴다.
model MfaRecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int
  codeHash  String    @db.Char(64)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

// 비밀번호를 통과한 2FA 사용자의 로그인 2단계 대기(5분, 1회용). id는 mfaToken 원문의 SHA-256이다.
model MfaChallenge {
  id           String    @id @db.Char(64)
  userId       Int
  tokenVersion Int
  attempts     Int       @default(0)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum DlpAction {
  BLOCK
  WARN
}

// 데이터 유출 방지(E10) 규칙. 내장 규칙(builtin)은 key로 코드의 탐지기와 연결되며 켜고 끄기만 된다.
// 사용자 정의 규칙의 pattern은 저장할 때 검증한다(길이, 위험한 중첩 수량자, 컴파일).
model DlpRule {
  id          Int       @id @default(autoincrement())
  key         String?   @unique @db.VarChar(40) // 내장 규칙 식별자. 사용자 정의 규칙은 null
  name        String    @unique @db.VarChar(100)
  pattern     String    @db.VarChar(500)
  action      DlpAction @default(BLOCK)
  enabled     Boolean   @default(true)
  builtin     Boolean   @default(false)
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([enabled])
}

// OAuth 2.1 인가 서버(mcp-4). 동적 클라이언트 등록(RFC 7591)으로 만든 클라이언트.
// clientId는 공개 값이다. 기밀 클라이언트(client_secret_basic/post)만 비밀을 받고, DB에는 sha256 해시만 둔다.
model OAuthClient {
  id                      Int       @id @default(autoincrement())
  clientId                String    @unique @db.VarChar(64)
  clientSecretHash        String?   @db.Char(64)
  tokenEndpointAuthMethod String    @db.VarChar(32)
  clientName              String    @db.VarChar(100)
  redirectUris            String[]
  // 마지막으로 토큰을 발급한 때. 한 번도 없고 30일 지난 등록은 정리 작업이 지운다.
  lastIssuedAt            DateTime?
  createdAt               DateTime  @default(now())

  codes  OAuthAuthorizationCode[]
  tokens OAuthToken[]

  @@index([createdAt])
}

// 인가 코드: 10분, 1회용. 원문은 리다이렉트로 한 번만 나가고 DB에는 sha256 해시만 둔다.
// 이미 쓴 코드가 다시 오면 그 코드로 만든 토큰 계열(familyId)을 폐기한다(RFC 6749 4.1.2).
model OAuthAuthorizationCode {
  id            Int       @id @default(autoincrement())
  codeHash      String    @unique @db.Char(64)
  clientId      Int
  userId        Int
  redirectUri   String    @db.VarChar(2000)
  scopes        String[]
  resource      String    @db.VarChar(500)
  codeChallenge String    @db.VarChar(128)
  // 동의 시점 사용자 tokenVersion. 교환 때 달라졌으면(비밀번호 변경 등) 거부한다.
  tokenVersion  Int
  expiresAt     DateTime
  usedAt        DateTime?
  familyId      String?   @db.VarChar(32)
  createdAt     DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

// 발급한 액세스·리프레시 토큰 한 쌍. 리프레시하면 같은 familyId로 새 행을 만들고 옛 행은 rotatedAt을 채운다.
// 이미 회전된 리프레시 토큰이 다시 오면 탈취로 보고 계열 전체를 폐기한다. 토큰은 해시로 조회한다(원문 저장 안 함).
// tokenVersion은 발급 시점 사용자 값이다. 비밀번호 변경·2FA 변경·관리자 강제 로그아웃으로 올라가면 토큰이 무효가 된다.
model OAuthToken {
  id               Int       @id @default(autoincrement())
  familyId         String    @db.VarChar(32)
  // 계열 첫 발급 시각(연결한 때). 회전할 때 그대로 복사해 옛 행을 지워도 남는다.
  familyCreatedAt  DateTime
  clientId         Int
  userId           Int
  accessTokenHash  String    @unique @db.Char(64)
  refreshTokenHash String?   @unique @db.Char(64)
  scopes           String[]
  resource         String    @db.VarChar(500)
  tokenVersion     Int
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime?
  rotatedAt        DateTime?
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId, revokedAt])
  @@index([clientId])
  @@index([refreshExpiresAt])
}

// 보존 정리의 저장소 삭제 아웃박스. 파일 행을 지우는 같은 트랜잭션에서 지울 저장소 키를 여기에 넣고,
// 커밋 뒤 본체 삭제에 성공한 행만 지운다. 실패(또는 커밋 뒤 프로세스 중단)한 행은 남아 다음 정리 실행 시작 때 다시 처리한다.
// 최대 시도 횟수를 넘기거나 영구 실패(업로드 폴더 밖 경로)면 로그를 남기고 지운다.
model StorageDeletionRetry {
  id          Int       @id @default(autoincrement())
  filename    String    @db.VarChar(255)
  gcsPath     String?
  attempts    Int       @default(0)
  lastError   String?   @db.VarChar(500)
  lastTriedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([attempts, id])
}
