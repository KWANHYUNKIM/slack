# Database connection string
# For production, append ?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/slackclone"

# JWT secret - REQUIRED in production
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Server port
PORT=3000

# Environment: development | production | test
NODE_ENV=development

# CORS origin - defaults to http://localhost:5173 in development
# Set explicitly for production (e.g., https://your-domain.com)
# CORS_ORIGIN=

# Google Cloud Storage bucket name (optional - uses local storage if not set)
# GCS_BUCKET_NAME=

# 첫 OWNER 생성 CLI(`node dist/scripts/create-owner.js`)용. 가능하면 비워 두고 대화형 입력을 쓴다.
# 이메일·이름은 비워 두면 --email, --name 옵션으로 넘긴다. 비밀번호는 비워 두고 숨김 프롬프트로 입력한다.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_PASSWORD=

# 감사 로그 보존 일수. 비우거나 0이면 무기한 보관한다. 값이 있으면 하루 한 번 이보다 오래된 행을 지운다.
AUDIT_LOG_RETENTION_DAYS=

# 세션 정책(E7). 최대 수명(일)과 유휴 만료(시간). 비우면 기본값 7일, 96시간.
SESSION_MAX_AGE_DAYS=
SESSION_IDLE_TIMEOUT_HOURS=
